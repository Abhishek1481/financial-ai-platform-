# Copy to .env for local development (not auto-loaded — Go reads real
# process env vars; use `set -a; source .env; set +a` or your shell/IDE's
# env-file support). All settings are prefixed GATEWAY_ and defined in
# internal/config/config.go.

GATEWAY_ENVIRONMENT=development
GATEWAY_HTTP_HOST=0.0.0.0
GATEWAY_HTTP_PORT=8080
GATEWAY_METRICS_HOST=0.0.0.0
GATEWAY_METRICS_PORT=9090
GATEWAY_LOG_LEVEL=info
GATEWAY_SHUTDOWN_TIMEOUT=10s
