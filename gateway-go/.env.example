# Copy to .env for local development (not auto-loaded — Go reads real
# process env vars; use `set -a; source .env; set +a` or your shell/IDE's
# env-file support). All settings are prefixed GATEWAY_ and defined in
# internal/config/config.go.

GATEWAY_ENVIRONMENT=development
GATEWAY_HTTP_HOST=0.0.0.0
GATEWAY_HTTP_PORT=8080
GATEWAY_METRICS_HOST=0.0.0.0
GATEWAY_METRICS_PORT=9090
GATEWAY_LOG_LEVEL=info
GATEWAY_SHUTDOWN_TIMEOUT=10s

# JWT signing secret. The default below is INSECURE and only accepted when
# GATEWAY_ENVIRONMENT=development — Load() refuses to start in production
# without a real value here.
GATEWAY_JWT_SECRET=dev-insecure-secret-change-me
GATEWAY_JWT_TTL=1h

# Seeds the one admin account this phase supports (no self-service admin
# registration). Same production restriction as GATEWAY_JWT_SECRET applies
# to GATEWAY_ADMIN_PASSWORD.
GATEWAY_ADMIN_EMAIL=admin@example.com
GATEWAY_ADMIN_PASSWORD=dev-insecure-admin-change-me

# Where ml-service's gRPC server (see ml-service/.env.example's
# ML_SERVICE_GRPC_PORT) is reachable.
GATEWAY_ML_SERVICE_ADDR=localhost:50051

# Local-filesystem stand-in for real object storage (S3/MinIO lands in
# Phase 16) — see internal/storage.LocalObjectStore.
GATEWAY_STORAGE_DIR=./data/documents

GATEWAY_MAX_UPLOAD_SIZE_MB=25

# Bounded worker pool that calls ml-service to extract each uploaded
# document — see internal/worker.Pool.
GATEWAY_INGESTION_WORKERS=4
GATEWAY_INGESTION_QUEUE_SIZE=100

# How long an identical GET /api/v1/search result is served from
# internal/cache.Cache before re-querying ml-service. 0 disables caching.
GATEWAY_SEARCH_CACHE_TTL=30s

# internal/ratelimit.Limiter, applied to all of /api/v1, keyed per client
# IP: a token bucket refilling at RPS tokens/second up to BURST tokens.
GATEWAY_RATE_LIMIT_RPS=5
GATEWAY_RATE_LIMIT_BURST=10

# How often (and after how long unused) internal/scheduler prunes stale
# conversation.MemoryStore sessions — see cmd/gateway/main.go.
GATEWAY_CONVERSATION_PRUNE_INTERVAL=10m
GATEWAY_CONVERSATION_MAX_AGE=24h

# Empty (default) keeps the search cache and conversation memory
# in-process (MemoryCache/MemoryStore). Set to a reachable Redis address
# (docker-compose.yml sets this to "redis:6379") to switch both to
# Redis-backed implementations instead — see internal/cache/redis_cache.go
# and internal/conversation/redis_store.go.
GATEWAY_REDIS_ADDR=
