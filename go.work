go 1.25.0

// Each Go service (gateway-go now; scheduler and worker from Phase 6/13
// onward) is its own module with its own go.mod — independently
// versionable and buildable — but developed together via this workspace
// so local changes to a shared package are visible across modules without
// publishing a release first.
//
// proto/gen/go is the generated gRPC stub module every Go service depends
// on. Its .go files are gitignored and regenerated by `make proto-go` (the
// proto contracts in /proto are the source of truth, not this output) —
// but go.mod itself is committed so `go build` has a module to resolve
// before that generation step has run.
use (
	./gateway-go
	./proto/gen/go
)
