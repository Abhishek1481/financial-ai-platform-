# Copy to .env for local development. All settings are prefixed
# ML_SERVICE_ and defined in app/config.py.

ML_SERVICE_ENVIRONMENT=development
ML_SERVICE_GRPC_HOST=0.0.0.0
ML_SERVICE_GRPC_PORT=50051
ML_SERVICE_LOG_LEVEL=INFO
ML_SERVICE_REFLECTION_ENABLED=true

# EmbeddingModel loads lazily — this is cheap config, not a trigger to
# download weights. embedding_dimension must match the model's actual
# output dimension (see app/config.py's comment on why it's separate).
ML_SERVICE_EMBEDDING_MODEL_NAME=sentence-transformers/all-MiniLM-L6-v2
ML_SERVICE_EMBEDDING_DIMENSION=384

# FaissVectorStore persists here so embeddings survive a restart. Empty
# string keeps everything in-memory only.
ML_SERVICE_VECTOR_STORE_DIR=./data/vector-store
