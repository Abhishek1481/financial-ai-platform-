# Go
gateway-go/bin/
scheduler/bin/
worker/bin/
*.exe
*.test
*.out

# Python
ml-service/__pycache__/
ml-service/**/__pycache__/
ml-service/.venv/
ml-service/venv/
*.pyc
.pytest_cache/
.mypy_cache/
.ruff_cache/
*.egg-info/

# Generated protobuf (regenerated by `make proto`, not hand-edited). Listed
# by file pattern rather than excluding proto/gen/ wholesale, because git
# can't re-include a file inside an already-excluded directory —
# proto/gen/go/go.mod/go.sum need to survive: they declare the module
# boundary every Go service depends on via go.work, and must exist before
# `make proto-go` has ever run on a fresh checkout.
proto/gen/**/*.pb.go
proto/gen/**/*_pb2.py
proto/gen/**/*_pb2.pyi
proto/gen/**/*_pb2_grpc.py

# Env / secrets
.env
.env.*
!.env.example
*.pem
*.key

# Data / models (never commit large binaries)
**/data/
**/*.faiss
**/*.index
**/models/

# IDE
.vscode/
.idea/

# Terraform
terraform/**/.terraform/
terraform/**/*.tfstate
terraform/**/*.tfstate.*
terraform/**/.terraform.lock.hcl
# Real values (terraform.tfvars.example is the committed template).
terraform/**/terraform.tfvars
terraform/**/*.auto.tfvars

# OS
.DS_Store
Thumbs.db
